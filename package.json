{
  "name": "english-with-ai-bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram English conversation tutor with voice and provider fallback",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsx src/copy-assets.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "tsx src/doctor.ts",
    "db:migrate": "tsx src/migrate.ts",
    "start:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 Start",
    "stop:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 Stop",
    "status:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 Status"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
