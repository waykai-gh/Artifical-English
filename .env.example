# Existing BOT_TOKEN is supported. Never commit real keys.
BOT_TOKEN=
# Required, no fallback. Use a random password with at least 24 characters.
POSTGRES_PASSWORD=
# Local Node only; encode special password characters in the URL.
DATABASE_URL=
# Stable random 32+ characters for local Node; production preparation persists its own key.
SECURITY_HMAC_KEY=
POSTGRES_PORT=15432

# false: only ALLOWED_USER_IDS can chat; /id works for everyone in private chat.
PUBLIC_BOT=true
ALLOWED_USER_IDS=

# Hidden /admin dashboard and operational alerts. Comma-separated Telegram IDs.
ADMIN_TELEGRAM_IDS=
ALERTS_ENABLED=true
# Transient provider/update errors alert only after this many failures in 5 minutes.
ALERT_TRANSIENT_FAILURE_THRESHOLD=3
# Suppress repeated alerts with the same cause for this many minutes.
ALERT_COOLDOWN_MINUTES=30
# Warn when a configured daily provider budget reaches this percentage.
ALERT_BUDGET_PERCENT=80
# Optional external dead-man switch (for example Healthchecks.io). Configure its Telegram integration separately.
HEALTHCHECK_PING_URL=
HEALTHCHECK_INTERVAL_SECONDS=60
# Production preparation sets /run/backup-status; leave empty for local development.
BACKUP_STATUS_DIR=
# Base free-tier defaults; set 0 when the account has a different/unknown budget.
GROQ_DAILY_TOKEN_BUDGET=200000
# Defaults below match @cf/qwen/qwen3-30b-a3b-fp8; update them when changing model.
CLOUDFLARE_DAILY_NEURON_BUDGET=10000
CLOUDFLARE_INPUT_NEURONS_PER_MILLION=4625
CLOUDFLARE_OUTPUT_NEURONS_PER_MILLION=30475
OPENROUTER_DAILY_REQUEST_BUDGET=50

# One key is enough for text; add multiple services for fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CHAT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_PROVIDER_ORDER=groq,cloudflare,gemini,openrouter
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Only openrouter/free or a model ending in :free is accepted.
OPENROUTER_CHAT_MODEL=openrouter/free

GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# Windows: installed English voice. Docker/Linux: espeak-ng.
LOCAL_TTS_FALLBACK=true
# Optional path to installed ffmpeg; otherwise ffmpeg-static is used.
FFMPEG_PATH=

DEFAULT_LEVEL=B1
DEFAULT_EXPLANATION_LANGUAGE=ru
DEFAULT_CORRECTIONS=detailed
# auto: speak in response to voice; on: always; off: text only.
DEFAULT_VOICE_MODE=auto
MAX_VOICE_SECONDS=120
MAX_AUDIO_BYTES=10485760
MAX_TEXT_CHARS=4000
HISTORY_TURNS=8
HISTORY_MAX_CHARS=6000
VOCABULARY_LIMIT=1000
RETENTION_DAYS=30
DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_REQUEST_LIMIT=500
GLOBAL_MINUTE_REQUEST_LIMIT=30
UPDATE_CONCURRENCY=2
REQUEST_COOLDOWN_SECONDS=4
PROVIDER_TIMEOUT_MS=30000
LOG_LEVEL=info
