# Existing BOT_TOKEN is supported. Never commit real keys.
BOT_TOKEN=
DATABASE_URL=postgresql://english:english_local_only@localhost:15432/english
POSTGRES_PORT=15432

# false: only ALLOWED_USER_IDS can chat; /id works for everyone in private chat.
PUBLIC_BOT=true
ALLOWED_USER_IDS=

# One key is enough for text; add multiple services for fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CHAT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_PROVIDER_ORDER=groq,cloudflare,gemini,openrouter
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Only openrouter/free or a model ending in :free is accepted.
OPENROUTER_CHAT_MODEL=openrouter/free

GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# Windows: installed English voice. Docker/Linux: espeak-ng.
LOCAL_TTS_FALLBACK=true
# Optional path to installed ffmpeg; otherwise ffmpeg-static is used.
FFMPEG_PATH=

DEFAULT_LEVEL=B1
DEFAULT_EXPLANATION_LANGUAGE=ru
DEFAULT_CORRECTIONS=detailed
# auto: speak in response to voice; on: always; off: text only.
DEFAULT_VOICE_MODE=auto
MAX_VOICE_SECONDS=120
MAX_AUDIO_BYTES=10485760
MAX_TEXT_CHARS=4000
HISTORY_TURNS=8
HISTORY_MAX_CHARS=6000
VOCABULARY_LIMIT=1000
RETENTION_DAYS=30
DAILY_REQUEST_LIMIT=100
REQUEST_COOLDOWN_SECONDS=4
PROVIDER_TIMEOUT_MS=30000
LOG_LEVEL=info
